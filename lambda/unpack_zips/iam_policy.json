{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawTree",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::my-tcu-bucket/academia/*"
    },
    {
      "Sid": "ListBucketForRawAndDerived",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::my-tcu-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "academia/*",
            "unpacked/*",
            "_manifests/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteDerivedTrees",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::my-tcu-bucket/unpacked/*",
        "arn:aws:s3:::my-tcu-bucket/_manifests/*"
      ]
    },
    {
      "Sid": "NoDeleteEver",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteObjectTagging",
        "s3:DeleteObjectVersionTagging",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-tcu-bucket",
        "arn:aws:s3:::my-tcu-bucket/*"
      ]
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
